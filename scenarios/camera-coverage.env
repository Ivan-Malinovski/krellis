# The nested session reads Ivan's kdedefaults (kwinrc theme=__aurorae__svg__FieldworkDark) but not his data
# dir, so that decoration cannot be found: KWin falls back to no decoration, Qt draws a titlebar *inside* the
# window surface, and `dump`'s client rect (KWin's clientGeometry) no longer marks where the client's own
# coordinates are painted. A real server-side decoration restores that. Falls back to any installed Aurorae
# theme, and stays unset when there is none, so the scenario still runs on a machine without that theme.
NEST_SOCKET=krellis-test-camera-coverage-$$
NEST_EFFECTS=krellis,krellis_paint_probe

_nest_theme=${NEST_AURORAE_THEME_DIR:-$HOME/.local/share/aurorae/themes/FieldworkDark}
[ -d "$_nest_theme" ] || _nest_theme=$(ls -d /usr/share/aurorae/themes/*/ 2>/dev/null | head -1)
if [ -n "$_nest_theme" ] && [ -d "$_nest_theme" ]; then NEST_AURORAE_THEME_DIR=$_nest_theme; else unset NEST_AURORAE_THEME_DIR; fi
