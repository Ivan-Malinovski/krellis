NEST_SOCKET=krellis-test-fractional-output-$$
# One scale per output, left to right. scenarios/fractional-output-kwin/kwin_wayland writes them into the
# nested KWin's kwinoutputconfig.json before it starts (KWin 6.8.2 has no runtime scale API).
KRELLIS_TEST_OUTPUT_SCALES="1.25 1.5"
PATH="$PWD/scenarios/fractional-output-kwin:$PATH"
